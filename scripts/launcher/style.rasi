/**
 *
 * Nord Rofi Launcher
 *
 **/

/*****----- Configuration -----*****/
configuration {
    modi:                       "drun,run,filebrowser,window";
    show-icons:                 true;

    display-drun:               "󰀻  APPS";
    display-run:                "  RUN";
    display-filebrowser:        "󰉋  FILES";
    display-window:             "󰖲  WINDOW";

    drun-display-format:        "{name}";
    window-format:              "{w} · {c} · {t}";
}

/*****----- Global Properties -----*****/
* {
    font:                       "IBM Plex Mono 14";

    nord0:                      #2e3440;
    nord1:                      #3b4252;
    nord2:                      #434c5e;
    nord3:                      #4c566a;

    nord4:                      #d8dee9;
    nord5:                      #e5e9f0;
    nord6:                      #eceff4;

    nord7:                      #8fbcbb;
    nord8:                      #88c0d0;
    nord9:                      #81a1c1;
    nord10:                     #5e81ac;
    nord11:                     #bf616a;

    nord12:                     #d08770;
    nord13:                     #ebcb8b;
    nord14:                     #a3be8c;
    nord15:                     #b48ead;

    background-color:            transparent;
    text-color:                  @nord4;
    accent-color:                @nord8;
}

/*****----- Main Window -----*****/
window {
    transparency:               "real";
    location:                   center;
    anchor:                     center;
    fullscreen:                 false;
    width:                      1000px;

    x-offset:                   0px;
    y-offset:                   0px;

    enabled:                    true;
    border:                     1px solid;
    border-radius:              16px;
    border-color:               @nord2;
    cursor:                     "default";
    background-color:           @nord0;
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                    true;
    spacing:                    0px;
    margin:                     0px;
    padding:                    0px;
    background-color:           transparent;
    orientation:                horizontal;
    children:                   [ "imagebox", "listbox" ];
}

/*****----- Image Box -----*****/
imagebox {
    enabled:                    true;
    padding:                    20px;
    background-color:           transparent;
    background-image:           url("~/.config/rofi/images/nord_1.jpg", height);
    orientation:                vertical;
    children:                   [ "inputbar", "message", "dummy", "mode-switcher" ];
}

dummy {
    enabled:                    true;
    expand:                     true;
    background-color:           transparent;
}

/*****----- List Box -----*****/
listbox {
    enabled:                    true;
    spacing:                    20px;
    padding:                    20px;
    background-color:           transparent;
    orientation:                vertical;
    children:                   [ "listview" ];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                    true;
    spacing:                    10px;
    margin:                     0px;
    padding:                    14px;
    border:                     1px solid;
    border-radius:              10px;
    border-color:               @nord2;
    background-color:           @nord1;
    text-color:                 @nord4;

    children:                   [ "textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
    enabled:                    true;
    expand:                     false;
    str:                        "󰍉";
    background-color:           transparent;
    text-color:                 @accent-color;
}

entry {
    enabled:                    true;
    background-color:           transparent;
    text-color:                 @nord6;
    cursor:                     text;

    placeholder:                "Search applications...";
    placeholder-color:          @nord3;
}

/*****----- Mode Switcher -----*****/
mode-switcher {
    enabled:                    true;
    spacing:                    10px;
    background-color:           transparent;
    text-color:                 @nord4;
}

button {
    padding:                    12px 14px;
    border:                     1px solid;
    border-radius:              10px;
    border-color:               @nord2;
    background-color:           @nord1;
    text-color:                 @nord4;
    cursor:                     pointer;
}

button selected {
    background-color:            @accent-color;
    border-color:                @accent-color;
    text-color:                  @nord0;
}

/*****----- Listview -----*****/
listview {
    enabled:                    true;
    columns:                    1;
    lines:                      8;

    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;

    layout:                     vertical;
    reverse:                    false;
    fixed-height:               true;
    fixed-columns:              true;

    spacing:                    10px;
    margin:                     0px;
    padding:                    0px;

    background-color:            transparent;
    text-color:                  @nord4;
    cursor:                     "default";
}

/*****----- Elements -----*****/
element {
    enabled:                    true;
    spacing:                    15px;
    margin:                     0px;
    padding:                    10px 12px;

    border:                     1px solid;
    border-radius:              10px;
    border-color:               transparent;

    background-color:            transparent;
    text-color:                  @nord4;
    cursor:                      pointer;
}

element normal.normal {
    background-color:            transparent;
    text-color:                  @nord4;
}

element normal.urgent {
    background-color:            @nord11;
    text-color:                  @nord6;
}

element normal.active {
    background-color:            @nord8;
    text-color:                  @nord0;
}

element selected.normal {
    background-color:            @nord10;
    border-color:                @nord9;
    text-color:                  @nord6;
}

element selected.urgent {
    background-color:            @nord11;
    border-color:                @nord11;
    text-color:                  @nord6;
}

element selected.active {
    background-color:            @nord8;
    border-color:                @nord7;
    text-color:                  @nord0;
}

element-icon {
    enabled:                    true;
    background-color:           transparent;
    text-color:                 inherit;
    size:                       32px;
    cursor:                     inherit;
}

element-text {
    enabled:                    true;
    background-color:           transparent;
    text-color:                 inherit;
    cursor:                     inherit;
    vertical-align:             0.5;
    horizontal-align:           0.0;
}

/*****----- Message -----*****/
message {
    enabled:                    true;
    margin:                     10px 0px 0px 0px;
    padding:                    0px;
    background-color:           transparent;
}

textbox {
    enabled:                    true;
    padding:                    0px;
    background-color:           transparent;
    text-color:                 @nord4;

    font:                       "IBM Plex Mono 11";
    vertical-align:             0.0;
    horizontal-align:           0.0;

    markup:                     true;
}

error-message {
    enabled:                    true;
    padding:                    15px;
    border:                     1px solid;
    border-radius:              10px;
    border-color:               @nord11;
    background-color:           @nord0;
    text-color:                 @nord6;
}
